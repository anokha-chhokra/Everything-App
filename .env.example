# Copy to .env to change settings. Every line is optional.

# Port and address. 127.0.0.1 keeps the app private to this computer.
# Use HOST=0.0.0.0 to open it from your phone on the same Wi-Fi.
PORT=3000
HOST=127.0.0.1

# Where the SQLite database lives.
DB_PATH=./data/dayhub.db

# --- Optional password (required when hosted) ---
# DAYHUB_PASSWORD=choose-something-long
# DAYHUB_SESSION_SECRET=a-long-random-string

# --- Hosted storage (Vercel adds these when you connect Upstash Redis) ---
# DB_CLIENT=upstash
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
